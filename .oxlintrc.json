{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react", "import", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "env": {
    "browser": true,
    "es2022": true
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "warn",
    // R3F mutates three.js objects (uniforms, materials) inside useFrame by design.
    "react/immutability": "off",
    // RULE_DEFS cards have a `then` field; nothing here is awaited.
    "unicorn/no-thenable": "off",
    // Casts are used deliberately at three.js and DOM boundaries.
    "typescript/no-unsafe-type-assertion": "off",
    // Side-effect imports (styles.css) are intended.
    "import/no-unassigned-import": "off",
    // The sim and UI use small arrays and index-keyed lists that never reorder.
    "unicorn/no-array-sort": "off",
    "unicorn/prefer-set-has": "off",
    "react/no-array-index-key": "off",
    // tsc already checks that every path returns the declared type.
    "typescript/consistent-return": "off",
    "no-shadow": "off",
    "no-underscore-dangle": "off"
  },
  "overrides": [
    {
      // An opt-in balance script that logs numbers instead of asserting.
      "files": ["src/sim/balance.test.ts"],
      "rules": { "vitest/expect-expect": "off" }
    },
    {
      // The sim must stay importable from a Web Worker and Node: no upper layers, no React/three (#250).
      "files": ["src/sim/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "../game",
                  "../game/*",
                  "../game/**",
                  "../../game",
                  "../../game/*",
                  "../../game/**",
                  "../render",
                  "../render/*",
                  "../render/**",
                  "../../render",
                  "../../render/*",
                  "../../render/**",
                  "../ui",
                  "../ui/*",
                  "../ui/**",
                  "../../ui",
                  "../../ui/*",
                  "../../ui/**",
                  "three",
                  "three/*",
                  "react",
                  "react/*",
                  "react-dom",
                  "react-dom/*",
                  "@react-three/*"
                ],
                "message": "src/sim must stay pure: no imports from game/, render/, ui/ or React/three."
              }
            ]
          }
        ],
        "no-restricted-properties": [
          "error",
          {
            "object": "Math",
            "property": "random",
            "message": "src/sim must stay deterministic: use rand(s) instead of Math.random()."
          }
        ]
      }
    },
    {
      // Tests may cross layer lines to exercise saves and formatters; the sim itself may not.
      "files": ["src/sim/**/*.test.ts"],
      "rules": { "no-restricted-imports": "off" }
    },
    {
      // The sim protocol stays in game. The UI formats events when it renders them.
      "files": ["src/game/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["../ui", "../ui/*", "../ui/**", "../../ui", "../../ui/*", "../../ui/**"],
                "message": "src/game must not import from src/ui."
              }
            ]
          }
        ]
      }
    }
  ],
  "ignorePatterns": ["dist", "node_modules"]
}
